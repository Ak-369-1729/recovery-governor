# ==============================================================================
# Recovery Governor - Environment Configuration
# ==============================================================================
# Note: The system runs completely out-of-the-box in Deterministic Fallback
# and Simulation mode if keys are left blank. No external credentials required.

# Google Gemini API Key (optional - activates Gemini live diagnosis if set)
GEMINI_API_KEY=

# Razorpay Test Mode Credentials (optional - activates test API adapter if set)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Database Configuration
DATABASE_URL=sqlite:///./data/recovery_governor.db

# Governor Policy Defaults
MAX_RETRIES=3
COOLDOWN_MINUTES=15
CUSTOMER_CONTACT_CAP=2
ECONOMIC_HURDLE=10.0
AI_CONFIDENCE_THRESHOLD=0.50
